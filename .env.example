# Copy to .env locally. This file contains names only; never commit actual credentials.
DETOUR_STORE=elasticsearch
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INFERENCE_ID=.jina-embeddings-v5-text-small
OTEL_SERVICE_NAME=detour-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Header format: Authorization=Bearer%20<token>. Never put a bare token here.
# Optional separate token for querying Dash0/MCP; never exposed to the frontend.
DASH0_AUTH_TOKEN=
DASH0_MCP_URL=
